---
import Analytics from '@vercel/analytics/astro';

import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Roichman Tech — Sistemas digitais para negócios sérios',
  description = 'Páginas de conversão, rastreamento, estrutura de anúncios e softwares personalizados para empresas que precisam de mais do que estar online.',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/webp" href="/logo-mark.webp" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/logo-mark.webp" />
    <meta name="twitter:card" content="summary" />

    <title>{title}</title>

    <Analytics />
  </head>
  <body class="bg-white text-black">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
